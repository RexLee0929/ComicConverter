<Window x:Class="ComicConverter.MsgDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ComicConverter" Height="200" MinHeight="150"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBrush}"
        FontFamily="Microsoft YaHei UI"
        SnapsToDevicePixels="True">

    <!-- 程序自己的提示框（规范 §七.2/§七.3）：不是系统借来的框，是主窗口长出来的一层。
         原生标题栏 + 同一套 DWM 配色、白卡、1px #E1E1E1、圆角 8、左侧 24 线性图标、
         右下角最多两个按钮（次按钮在左、主按钮在右）。
         宽高都不写死在 XAML（规范 §10.4：宽度必须运行时量）：
           · 宽：MsgDialog.MeasureWidth() 在 OnSourceInitialized 里量「标题 + 正文」最长的一行，
             加上卡片与图标的固定开销、窗口边框，夹在 320~640 之间 —— 短错误就是窄框，
             长正文才撑宽，一条标题更长的错误框自然比短提示宽。
           · 高：FitToContent 按 BodyScroll 的 ExtentHeight − ViewportHeight 校正 2 轮。
         所以改一句错误文案，框的宽高都会跟着变，不用手工重算。 -->
    <Border x:Name="Card" Margin="18" Background="{StaticResource CardBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            CornerRadius="8" Padding="20,18,20,16">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧图标：错误=红、警告=橙、询问=强调色、信息=中性灰（§七.3） -->
            <ContentControl x:Name="IconHost" Grid.Column="0" Width="24" Height="24"
                            Margin="0,1,14,0" VerticalAlignment="Top"/>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题说事：一句话讲清发生了什么，不用「提示 / 错误 / 警告」当标题 -->
                <TextBlock x:Name="TitleText" Grid.Row="0"
                           FontSize="13.5" FontWeight="SemiBold"
                           Foreground="{StaticResource InkBrush}"
                           TextWrapping="Wrap" Margin="0,0,0,8"/>

                <ScrollViewer x:Name="BodyScroll" Grid.Row="1" MaxHeight="320"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Background="Transparent" BorderThickness="0">
                    <TextBlock x:Name="BodyText" FontSize="12.5"
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" LineHeight="19"/>
                </ScrollViewer>

                <StackPanel x:Name="ButtonRow" Grid.Row="2" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button x:Name="BtnClose" Content="关闭" IsCancel="True"
                            MinWidth="86" Padding="14,6" Margin="0,0,8,0"
                            Click="Alt_Click"/>
                    <Button x:Name="BtnMain" Content="打开日志" IsDefault="True"
                            MinWidth="96" Style="{StaticResource PrimaryButton}"
                            Click="Main_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
