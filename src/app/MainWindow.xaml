<Window x:Class="ComicConverter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="ComicConverter" Height="820" Width="1280"
        Icon="app.ico"
        MinHeight="700" MinWidth="1120"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="{StaticResource WindowBrush}"
        FontFamily="Microsoft YaHei UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 菜单栏：内容由 AppMenu.Build() 生成，这里只留容器。
             样式在 Theme.xaml：与内容区同底色、悬停圆角块、白色卡片弹层。 -->
        <Border Grid.Row="0" Background="{StaticResource WindowBrush}" BorderThickness="0">
            <Menu x:Name="MainMenu"/>
        </Border>

        <!-- 内容区 -->
        <Grid Grid.Row="1">
            <wv2:WebView2 x:Name="Web" DefaultBackgroundColor="#F3F3F3"/>

            <Border x:Name="Splash" Background="#F3F3F3">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="app.ico" Width="60" Height="60"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <TextBlock Text="ComicConverter" FontSize="17" FontWeight="SemiBold"
                               Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtVersion" Text="" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    <TextBlock x:Name="TxtSplash" Text="正在启动…" FontSize="12.5"
                               Foreground="{StaticResource DimBrush}"
                               HorizontalAlignment="Center" Margin="0,10,0,0"
                               TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 状态栏：只承载「随操作变化」的运行时状态。
             规则见《程序本体设计规范》：程序名/版本/作者/邮箱一律不进状态栏，
             它们统一放在「帮助 → 关于」。 -->
        <Border Grid.Row="2" Background="{StaticResource WindowBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Height="26" Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 左：任务阶段 + 完成进度 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StPhase" Text="待命" FontSize="11.5" Foreground="{StaticResource InkBrush}"/>
                    <TextBlock x:Name="StCount" Text="完成 0/0" FontSize="11.5"
                               Foreground="{StaticResource MutedBrush}" Margin="12,0,0,0"/>
                    <TextBlock x:Name="StCurrent" Text="" FontSize="11.5" Foreground="{StaticResource DimBrush}"
                               Margin="12,0,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- 中：「已保存 / 已复制 / 出错」这类 1.8 秒自消的瞬时提示（规范 §六） -->
                <TextBlock Grid.Column="1" x:Name="StSaved" Text="" FontSize="11.5"
                           Foreground="{StaticResource DimBrush}"
                           Margin="14,0" VerticalAlignment="Center" HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>

                <!-- 右：当前生效的运行参数 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StTarget" Text="目标 双兼容" FontSize="11.5" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock x:Name="StReading" Text="方向 自动" FontSize="11.5"
                               Foreground="{StaticResource MutedBrush}" Margin="12,0,0,0"/>
                    <TextBlock x:Name="StJobs" Text="并发 6" FontSize="11.5"
                               Foreground="{StaticResource MutedBrush}" Margin="12,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
