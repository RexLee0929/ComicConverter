<Window x:Class="ComicConverter.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于 ComicConverter"
        Height="300" MinHeight="240"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBrush}"
        FontFamily="Microsoft YaHei UI">

    <!-- 三段式（与 txtFormat 同构）：内容框 / 联系条 / 按钮栏。
         宽高都由内容决定，XAML 里不写宽度（规范 §10.4：宽度必须运行时量）：
           · 宽：AboutDialog.MeasureWidth() 在 OnSourceInitialized 里按「最长的一行不可断内容」
             量出自然宽，加上卡片外边距/边距/窗口边框（这些数从控件自身属性读，不在 C# 里抄），
             夹在 320~640 之间 —— 640 是阅读行宽上限，正文超了就换行，不把窗口撑宽。
           · 高：ContentRendered 后按富文本真实内容高度校正（FitToContent），3 轮收敛。
         所以改 ABOUT.md 的文案，窗口宽度和高度都会跟着变，不用手工重算任何数字。
         不能用 SizeToContent 量高——WPF 对 RichTextBox 量出来偏小，会把后两段挤出窗口；
         也不允许用户手动缩放（NoResize），MinHeight 只留 240 兜底。
         想看当前实测值：跑一遍 tools/ui_render，输出里有 natural-width / doc width 两行。 -->
    <Grid Margin="20,14,20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1) 内容框：富文本，文本可选中（txtFormat 用 QTextBrowser，这里用只读 RichTextBox 等价替代） -->
        <Border x:Name="DocCard" Grid.Row="0" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="14,20,14,26" Margin="0,0,0,10">
            <RichTextBox x:Name="Doc" IsReadOnly="True" IsDocumentEnabled="False"
                         BorderThickness="0" Background="Transparent"
                         Padding="0" Margin="0"
                         FontSize="12" Foreground="{StaticResource InkBrush}"
                         HorizontalScrollBarVisibility="Disabled"
                         VerticalScrollBarVisibility="Hidden"
                         IsTabStop="False" AcceptsReturn="False" AcceptsTab="False"/>
        </Border>

        <!-- 2) 联系条：作者 + 邮箱胶囊（点击即复制）+ 反馈位（平时为空） -->
        <Border Grid.Row="1" Background="{StaticResource CardAltBrush}" CornerRadius="8"
                Padding="14,9" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="作者  " FontSize="12" Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Author}" FontSize="12"
                           Foreground="{StaticResource InkBrush}" VerticalAlignment="Center"/>
                <Border x:Name="EmailChip" Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="10,3" Margin="10,0,0,0"
                        Cursor="Hand" MouseLeftButtonUp="Email_Click"
                        ToolTip="点击复制邮箱">
                    <StackPanel Orientation="Horizontal">
                        <ContentControl x:Name="EmailIcon" Width="13" Height="13"
                                        VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="EmailText" Text="{Binding Email}" FontSize="12"
                                   Foreground="{StaticResource InkBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <!-- 平时为空；点击复制后在这里显示「已复制到剪贴板」，1.6 秒后自动消失 -->
                <TextBlock x:Name="CopyHint" Text="" FontSize="11"
                           Foreground="{DynamicResource AccentBrush}" Margin="10,0,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 3) 按钮栏：只有一个关闭按钮（复制已经由邮箱胶囊承担，不再单独放按钮） -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnClose" Style="{StaticResource PrimaryButton}" Content="关闭"
                    MinWidth="88" IsDefault="True" IsCancel="True" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
