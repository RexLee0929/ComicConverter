<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         Win11 Fluent 浅色主题令牌（与 txtFormat 同源）
         配色唯一来源是程序图标：AccentBrush 等由 Accent.cs 在启动时
         写入本字典（换图标整套界面自动换色）。中性灰固定。
         ============================================================ -->

    <!-- 中性色 -->
    <SolidColorBrush x:Key="WindowBrush"  Color="#F3F3F3"/>
    <SolidColorBrush x:Key="CardBrush"    Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardAltBrush" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="BorderBrush"  Color="#E1E1E1"/>
    <SolidColorBrush x:Key="InkBrush"     Color="#1B1B1B"/>
    <SolidColorBrush x:Key="MutedBrush"   Color="#5C5C5C"/>
    <SolidColorBrush x:Key="DimBrush"     Color="#8A8A8A"/>
    <SolidColorBrush x:Key="HoverBrush"   Color="#F5F5F5"/>
    <SolidColorBrush x:Key="PressedBrush" Color="#EBEBEB"/>
    <SolidColorBrush x:Key="MenuBarHoverBrush" Color="#E8E8E8"/>
    <!-- 兜底强调色：Accent.Init() 会用图标取出的主色覆盖它 -->
    <SolidColorBrush x:Key="AccentBrush"      Color="#0F6E56"/>
    <SolidColorBrush x:Key="AccentSoftBrush"  Color="#E6F2EE"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#0B5A46"/>
    <SolidColorBrush x:Key="AccentDarkBrush"  Color="#0B5A46"/>

    <!-- ============================================================ 菜单栏 -->

    <Style TargetType="Menu">
        <Setter Property="Background" Value="{StaticResource WindowBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
    </Style>

    <Style x:Key="MenuSepStyle" TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{StaticResource BorderBrush}"
                            Margin="10,5" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 子菜单项：图标列 + 文本 + 右侧快捷键，悬停浅灰、圆角 4 -->
    <ControlTemplate x:Key="SubMenuItemTemplate" TargetType="MenuItem">
        <Border x:Name="Bd" Background="Transparent" CornerRadius="4"
                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" VerticalAlignment="Center">
                    <ContentPresenter x:Name="Ico" ContentSource="Icon"
                                      Width="16" Height="16" VerticalAlignment="Center"/>
                    <Viewbox x:Name="Chk" Width="14" Height="14" Visibility="Collapsed">
                        <Canvas Width="24" Height="24">
                            <Path Data="M4.5 12.5l5 5L19.5 7"
                                  Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Canvas>
                    </Viewbox>
                </Grid>

                <ContentPresenter Grid.Column="1" ContentSource="Header" Margin="9,0,0,0"
                                  RecognizesAccessKey="True" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}"
                           Foreground="{StaticResource DimBrush}" FontSize="11.5"
                           Margin="22,0,2,0" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Chk" Property="Visibility" Value="Visible"/>
                <Setter TargetName="Ico" Property="Visibility" Value="Collapsed"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- 菜单栏一级项：文字 + 悬停圆角块，展开时挂白色卡片弹层 -->
    <ControlTemplate x:Key="TopHeaderTemplate" TargetType="MenuItem">
        <Grid>
            <Border x:Name="Bd" Background="Transparent" CornerRadius="4"
                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                  VerticalAlignment="Center"/>
            </Border>
            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                   Placement="Bottom" VerticalOffset="3" PopupAnimation="Fade"
                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                <Border Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="5" Margin="10" SnapsToDevicePixels="True">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270"
                                          Opacity="0.16" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel IsItemsHost="True"
                                KeyboardNavigation.DirectionalNavigation="Cycle"/>
                </Border>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource MenuBarHoverBrush}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Padding" Value="12,7,12,7"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template" Value="{StaticResource SubMenuItemTemplate}"/>
        <Style.Triggers>
            <Trigger Property="Role" Value="TopLevelHeader">
                <Setter Property="Template" Value="{StaticResource TopHeaderTemplate}"/>
                <Setter Property="Padding" Value="11,5"/>
            </Trigger>
            <Trigger Property="Role" Value="TopLevelItem">
                <Setter Property="Template" Value="{StaticResource TopHeaderTemplate}"/>
                <Setter Property="Padding" Value="11,5"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================================ 按钮 -->

    <!-- 普通按钮：白底描边圆角 4 -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#D6D6D6"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PressedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 主按钮：品牌色底白字（品牌色来自图标） -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- 主按钮悬停不变色：它常是窗口里唯一的实心色块，
                             鼠标经过就换色会被误认为状态变化（用户明确反馈过）。
                             只在按下时加深，作为点击反馈。 -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentDarkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>